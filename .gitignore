# ── repository hygiene (2026-10-30) ───────────────────────────────────
# Local AI prompts / Trae instructions: kept on disk, never published.
# `docs/prompts/pending/` must keep existing locally (project rule).
docs/prompts/
docs/archive/prompts/
.prompt-backup-*/

# Local runtime evidence: audit logs, GUI screenshots, forensic scripts.
/runtime/

# Test-vault runtime state: settings, sidecars, loader config, traces.
# Regenerated by Typora / `pnpm run build:dev`; never a source of truth.
test/vault/.typora/

# Throwaway GUI fixtures created at the test-vault root during acceptance runs.
test/vault/__*

# Archived raw test-vault backups (may contain unpublished user documents).
docs/archive/test-vault/

# AI repair progress ledgers.
/REPAIR-PROGRESS.md

