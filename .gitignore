# npm
node_modules/

# yalc
.yalc/
yalc.lock

# output
dist/
plugin.zip
*.map

# logs
*.log

# backup / cache / temp
.backup-*
.pnpm-store/
*.bak
*.tmp
*.tsbuildinfo
coverage/

# one-off diagnostics / historical audit artifacts
scripts/diag/
artifacts/

# runtime generated sidecars (regenerated on Typora run)
test/vault/.typora/inkchapter/audit/
test/vault/.typora/inkchapter-outline-dom-dump.json
test/vault/.typora/inkchapter/captions/*.json
# per-document-folder Typora runtime state (hotkeys / plugin logger); the
# vault-level `test/vault/.typora/` stays versioned on purpose
test/vault/*/.typora/

# trae
.trae/

# project docs (root only; keeps scripts/docs/ tooling trackable)
/docs/
