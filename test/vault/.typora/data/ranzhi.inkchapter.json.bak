{
  "version": 1,
  "settings": {
    "headingNumbering": {
      "enabled": true,
      "showLevelOneNumber": false,
      "preset": "custom",
      "maxDepth": 6,
      "customDefinition": {
        "levels": {
          "1": {
            "enabled": true,
            "numberStyle": "chinese",
            "format": [
              {
                "type": "level-reference",
                "level": 1
              }
            ],
            "startAt": 1,
            "restartAfterLevel": null,
            "legalStyle": false,
            "position": {
              "alignment": "left",
              "alignedAtEm": 0,
              "textIndentAtEm": 2,
              "followWith": "space",
              "tabStopAtEm": null
            }
          },
          "2": {
            "enabled": true,
            "numberStyle": "chinese",
            "format": [
              {
                "type": "level-reference",
                "level": 2
              }
            ],
            "startAt": 1,
            "restartAfterLevel": 1,
            "legalStyle": false,
            "position": {
              "alignment": "left",
              "alignedAtEm": 0,
              "textIndentAtEm": 2,
              "followWith": "space",
              "tabStopAtEm": null
            }
          },
          "3": {
            "enabled": true,
            "numberStyle": "arabic",
            "format": [
              {
                "type": "level-reference",
                "level": 3
              },
              {
                "type": "level-reference",
                "level": 2
              },
              {
                "type": "literal",
                "value": "啊啊啊啊"
              }
            ],
            "startAt": 1,
            "restartAfterLevel": 2,
            "legalStyle": false,
            "position": {
              "alignment": "left",
              "alignedAtEm": 0,
              "textIndentAtEm": 2,
              "followWith": "space",
              "tabStopAtEm": null
            },
            "isCustomFormat": true
          },
          "4": {
            "enabled": true,
            "numberStyle": "arabic",
            "format": [
              {
                "type": "level-reference",
                "level": 4
              }
            ],
            "startAt": 1,
            "restartAfterLevel": 3,
            "legalStyle": false,
            "position": {
              "alignment": "left",
              "alignedAtEm": 0,
              "textIndentAtEm": 2,
              "followWith": "space",
              "tabStopAtEm": null
            }
          },
          "5": {
            "enabled": true,
            "numberStyle": "circled",
            "format": [
              {
                "type": "level-reference",
                "level": 5
              }
            ],
            "startAt": 1,
            "restartAfterLevel": 4,
            "legalStyle": false,
            "position": {
              "alignment": "left",
              "alignedAtEm": 0,
              "textIndentAtEm": 2,
              "followWith": "space",
              "tabStopAtEm": null
            }
          },
          "6": {
            "enabled": true,
            "numberStyle": "alpha-upper",
            "format": [
              {
                "type": "level-reference",
                "level": 6
              }
            ],
            "startAt": 1,
            "restartAfterLevel": 5,
            "legalStyle": false,
            "position": {
              "alignment": "left",
              "alignedAtEm": 0,
              "textIndentAtEm": 2,
              "followWith": "space",
              "tabStopAtEm": null
            }
          }
        }
      }
    }
  }
}